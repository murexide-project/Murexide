<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Murexide">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        
        <activity
            android:name=".ui.share.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Murexide">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receiver.SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data
                    android:scheme="android_secret_code"
                    android:host="2468" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.chatsearch.ChatSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.community.detail.PostDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.Murexide">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="post-detail"
                    android:scheme="yunhu" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.yhchat.com"
                    android:pathPrefix="/c/p/" />
                <data
                    android:scheme="https"
                    android:host="yhchat.com"
                    android:pathPrefix="/c/p/" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.community.ba.BaDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.Murexide">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="alley-detail"
                    android:scheme="yunhu" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.community.ba.CreatePostActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.community.myposts.MyPostsActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.conversation.CreationActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.components.MurexideOpenImageActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide.OpenImage" />
        <activity
            android:name=".ui.sticker.StickerDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.sticker.StickerPackManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.conversationdetail.ConversationDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.Murexide">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="chat-add"
                    android:scheme="yunhu" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yunhu"
                      android:host="chat-add" />
                <data android:scheme="https"
                      android:host="yhfx.jwznb.com" />
                <data android:scheme="yunhu"
                      android:host="jwznb.com" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.conversationdetail.InviteBotToGroupActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.mine.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.conversationdetail.GroupSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.conversationdetail.BotSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />
        <activity
            android:name=".ui.settings.switchAccount.SwitchAccountActivity"
            android:exported="false"
            android:theme="@style/Theme.Murexide" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>